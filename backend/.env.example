PORT=4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=shopmvc

# JWT
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d

# CORS - your frontend origin
CLIENT_URL=http://localhost:3000

# Mailer (optional, used for order confirmation and verification emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="OneSpace <no-reply@onespace.test>"

# Google OAuth (optional - required only for "Continue with Google" login)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
